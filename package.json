    "@scalar/fastify-api-reference": "^1.75.0",
    "@sentry/nestjs": "^11.8.0",
    "@sentry/profiling-node": "^11.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.20.0",
    "better-auth": "^1.7.10",
    "bullmq": "^6.3.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eventemitter2": "^6.4.9",
    "fastify": "^5.12.6",
    "graphql": "^16.14.2",
    "ioredis": "^6.0.0",
    "mercurius": "^16.12.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "proxy-addr": "^2.0.8",
    "reflect-metadata": "^0.2.2",
