{
  "name": "nestjs-fastify-nx",
  "version": "1.2.1",
  "license": "MIT",
  "scripts": {
    "postinstall": "node -e \"require('fs').existsSync('prisma/schema.prisma')&&require('child_process').execSync('pnpm exec prisma generate',{stdio:'inherit'})\"",
    "prepare": "node -e \"process.env.CI||require('child_process').execSync('lefthook install',{stdio:'inherit'})\"",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "lint": "nx affected --target=lint",
    "lint:all": "nx run-many --target=lint --all",
    "lint:fix": "nx affected --target=lint -- --fix",
    "lint:fix:all": "nx run-many --target=lint --all -- --fix",
    "typecheck": "nx affected --target=typecheck",
    "typecheck:all": "nx run-many --target=typecheck --all",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .prettierignore",
    "codegen": "orval --config orval.config.ts",
    "codegen:export": "nx run api:codegen-export",
    "codegen:full": "pnpm codegen:export && pnpm codegen",
    "gen:module": "bash scripts/gen-module.sh modules",
    "gen:composition": "bash scripts/gen-module.sh composition",
    "gen:lib": "nx g @nx/js:library",
    "gen:app": "nx g @nx/nest:application",
    "rm:project": "bash scripts/remove-project.sh",
    "graph": "nx graph",
    "release": "nx release",
    "release:dry": "nx release --dry-run",
    "sync": "nx sync",
    "reset": "nx reset",
    "clean": "node tools/scripts/clean-workspace.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@bull-board/api": "^9.10.2",
    "@bull-board/fastify": "^9.10.2",
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/under-pressure": "^9.2.1",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/mercurius": "^14.0.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.1",
