    "tslib": "^2.8.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apiture/openapi-down-convert": "^0.14.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/nest": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.18",
    "@swc/helpers": "~0.5.23",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "~5.0.3",
    "eslint": "^10.13.0",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "nx": "23.3.0",
    "orval": "^8.43.0",
    "pino-pretty": "^13.2.0",
    "prettier": "~3.9.10",
    "supertest": "^7.3.1",
    "swc-loader": "^0.2.7",
    "testcontainers": "^12.2.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "~5.0.3",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.14.0",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "config": "prisma.config.ts"
  }
}
