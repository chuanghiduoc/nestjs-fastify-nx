generator client {
  provider            = "prisma-client"
  output              = "../libs/infra/database/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String           @default("")
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  role            String           @default("USER")
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  memberships     Member[]
  teamMembers     TeamMember[]
  sentInvitations Invitation[]
  apiKeys         ApiKey[]
  notifications   Notification[]
  termAcceptances TermAcceptance[]

  // The @unique on email already creates a B-tree — a separate @@index([email])
  // would just duplicate writes for zero query benefit, so it is intentionally
  // omitted here.
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([status, updatedAt])
  // Backs cursor pagination (ORDER BY createdAt DESC, id DESC). Sort order and name must match the
  // DDL exactly — otherwise `migrate diff` sees drift and the next `migrate dev` drops the index.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "users_createdAt_id_desc_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?       @db.Uuid
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  activeTeamId         String?       @db.Uuid
  activeTeam           Team?         @relation(fields: [activeTeamId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([activeTeamId])
  // Backs the scheduler's expired-session purge (SessionCleanupTask). Better Auth never deletes
  // a session row itself, so without this index "WHERE expiresAt < cutoff" degrades into a
  // sequential scan as the table grows unbounded.
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String
  issuer                String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  // Better Auth reads this table only by `identifier`, ordered by createdAt — every password-reset,
  // email-verification and delete-account confirmation. `expiresAt` backs the scheduler's purge.
  @@index([identifier, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("verifications")
}

model Organization {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members           Member[]
  invitations       Invitation[]
  teams             Team[]
  organizationRoles OrganizationRole[]
  activeSessions    Session[]
  apiKeys           ApiKey[]
  notifications     Notification[]
  featureFlags      FeatureFlag[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "organizations_createdAt_id_desc_idx")
  @@map("organizations")
}

model Member {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "members_org_createdAt_id_desc_idx")
  @@map("members")
}

model Invitation {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  role           String?
  teamId         String?  @db.Uuid
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@index([inviterId])
  @@index([teamId])
  @@map("invitations")
}

model Team {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  organizationId String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  invitations    Invitation[]
  activeSessions Session[]

  @@unique([organizationId, name])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "teams_org_createdAt_id_desc_idx")
  @@map("teams")
}

model TeamMember {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teamId    String    @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime? @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model OrganizationRole {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @db.Uuid
  role           String
  permission     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@map("organization_roles")
}

// Durable ownership and lifecycle state for finalized uploads. `userId` deliberately has no
// foreign key: the scheduler must still see and delete S3 objects after a user row is purged.
model StoredFile {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  sourceKey      String    @unique
  key            String    @unique
  bucket         String
  contentType    String
  size           Int
  etag           String
  status         String    @default("FINALIZING")
  failureReason  String?
  // CLEAN or SKIPPED_TOO_LARGE. Null until verification runs; SKIPPED_TOO_LARGE marks an object
  // published past the scanner's per-file ceiling, so READY alone never implies it was inspected.
  scanOutcome    String?
  verifiedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "stored_files_org_createdAt_id_desc_idx")
  @@index([deletedAt])
  @@map("stored_files")
}

// `id` is application-stamped UUIDv7 — producer needs the value inside the
// same transaction to correlate aggregate writes with the outbox row.
model OutboxEvent {
  id             String    @id @db.Uuid
  organizationId String?   @db.Uuid
  eventType      String
  aggregateId    String
  payload        Json
  processedAt    DateTime?
  attempts       Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())
  // Earliest time the relay may claim this row again. Stamped by the CLAIM statement itself (not
  // by the error handler) so a relay that crashes mid-dispatch still leaves the row invisible for
  // the backoff window instead of being re-claimed on the very next poll tick.
  nextAttemptAt  DateTime?

  // Relay scan path — must come first because (processedAt, createdAt) is the
  // leftmost prefix `WHERE processedAt IS NULL ORDER BY createdAt` uses.
  @@index([processedAt, createdAt])
  // Backoff-aware claim path: `WHERE processedAt IS NULL AND (nextAttemptAt IS NULL OR
  // nextAttemptAt <= NOW()) ORDER BY createdAt`.
  @@index([processedAt, nextAttemptAt, createdAt])
  // Ops debugging path — "show me all undelivered users.registered events".
  // Without this, the only access path is a full scan of outbox_events.
  @@index([eventType, processedAt])
  @@map("outbox_events")
}

// `userId` intentionally has no FK — audit must survive User deletion.
// Range-partitioned monthly by `createdAt` (see migration
// `20260501000000_init`). Postgres requires the partition key to participate
// in the primary key, hence the composite `@@id([id, createdAt])` —
// application stamps UUIDv7 ids so id-only uniqueness is preserved by
// construction even though no global UNIQUE constraint enforces it.
model AuditLog {
  id             String   @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  action         String
  resource       String?
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@id([id, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([organizationId, createdAt(sort: Desc)])
  // Compliance query path — "every admin action on resource X in window Y".
  // Two-column index with createdAt last so it remains useful for range scans.
  @@index([resource, createdAt])
  @@map("audit_logs")
}

// Machine-to-machine credential. Only the SHA-256 digest of the raw key is stored — the raw value
// is shown once at creation and is unrecoverable afterwards. `prefix` is the human-readable
// fragment the UI lists so an operator can tell two keys apart without seeing either secret.
model ApiKey {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  prefix         String
  keyHash        String    @unique
  scopes         String[]
  createdById    String?   @db.Uuid
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, revokedAt])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "api_keys_org_createdAt_id_desc_idx")
  @@index([createdById])
  @@map("api_keys")
}

model Notification {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  type           String
  title          String
  body           String
  data           Json      @default("{}")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_org_user_createdAt_id_desc_idx")
  @@index([userId, readAt])
  @@map("notifications")
}

// Scoped to one organization by design: a nullable organizationId would need a partial unique
// index to keep a single global row per key, which Prisma cannot declare (see ADR-0004).
model FeatureFlag {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId    String   @db.Uuid
  key               String
  description       String?
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "feature_flags_org_createdAt_id_desc_idx")
  @@map("feature_flags")
}

// Platform-wide legal documents. Not tenant-scoped: every organization is served the same
// published version, and acceptance is recorded per user.
model Term {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        String
  version     String
  content     String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  acceptances TermAcceptance[]

  @@unique([type, version])
  @@index([type, publishedAt(sort: Desc)])
  @@map("terms")
}

model TermAcceptance {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  termId     String   @db.Uuid
  userId     String   @db.Uuid
  acceptedAt DateTime @default(now())
  ipAddress  String?

  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([termId, userId])
  @@index([userId, acceptedAt(sort: Desc)])
  @@map("term_acceptances")
}
